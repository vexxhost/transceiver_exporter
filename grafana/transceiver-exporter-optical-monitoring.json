          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "transceiver_diagnostic_threshold{job=\"transceiver-exporter\",instance=~\"$instance\",interface=~\"$interface\",metric=\"temperature_celsius\",severity=\"warning\",boundary=\"high\"}",
          "legendFormat": "Warn High {{instance}} {{interface}}",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "transceiver_diagnostic_threshold{job=\"transceiver-exporter\",instance=~\"$instance\",interface=~\"$interface\",metric=\"temperature_celsius\",severity=\"alarm\",boundary=\"high\"}",
          "legendFormat": "Alarm High {{instance}} {{interface}}",
