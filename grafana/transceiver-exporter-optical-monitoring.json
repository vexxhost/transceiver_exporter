        {
          "editorMode": "code",
          "expr": "transceiver_diagnostic_threshold{job=\"transceiver-exporter\",instance=~\"$instance\",interface=~\"$interface\",metric=\"temperature_celsius\",severity=\"warning\",boundary=\"low\"}",
          "legendFormat": "Warn Low {{instance}} {{interface}}",
          "range": true,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "transceiver_diagnostic_threshold{job=\"transceiver-exporter\",instance=~\"$instance\",interface=~\"$interface\",metric=\"temperature_celsius\",severity=\"alarm\",boundary=\"low\"}",
          "legendFormat": "Alarm Low {{instance}} {{interface}}",
          "range": true,
          "refId": "E"
        }
